{
  "info": {
    "name": "Techno Online Store - Tenant Profile API",
    "description": "Profile management for tenant store customers (authenticated).\n\nBase URL: {{tenant_url}}/api\n\nSet `tenant_url` to the tenant subdomain, e.g. `https://store1.example.com`\nSet `auth_token` to the Sanctum token obtained from login/verify.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tenant_url",
      "value": "http://store1.localhost",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Profile",
      "item": [
        {
          "name": "Show Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{tenant_url}}/api/profile",
              "host": ["{{tenant_url}}"],
              "path": ["api", "profile"]
            },
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "description": "Get authenticated user's profile.\n\nRequires `auth:sanctum` bearer token."
          },
          "response": [
            {
              "name": "Success",
              "body": "{\n  \"success\": true,\n  \"message\": \"Fetched successfully\",\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"+1234567890\",\n    \"avatar\": \"https://store1.example.com/storage/tenant1/avatars/uuid.jpg\",\n    \"is_verified\": true,\n    \"created_at\": \"2026-07-26T12:00:00.000000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{tenant_url}}/api/profile",
              "host": ["{{tenant_url}}"],
              "path": ["api", "profile"]
            },
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "John Updated", "type": "text" },
                { "key": "email", "value": "john.updated@example.com", "type": "text" },
                { "key": "phone", "value": "+10987654321", "type": "text" },
                { "key": "avatar", "type": "file", "src": [] }
              ]
            },
            "description": "Update profile fields. All fields are optional (`sometimes`).\n\n- `name`: string, max 255\n- `email`: email, max 255, unique (excluding own)\n- `phone`: nullable string, max 20\n- `avatar`: image file, max 2MB\n\nUses `multipart/form-data` to support file upload."
          },
          "response": [
            {
              "name": "Success",
              "body": "{\n  \"success\": true,\n  \"message\": \"Success\",\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"John Updated\",\n    \"email\": \"john.updated@example.com\",\n    \"phone\": \"+10987654321\",\n    \"avatar\": \"https://store1.example.com/storage/tenant1/avatars/uuid.jpg\",\n    \"is_verified\": true,\n    \"created_at\": \"2026-07-26T12:00:00.000000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{tenant_url}}/api/profile/password",
              "host": ["{{tenant_url}}"],
              "path": ["api", "profile", "password"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"oldpassword123\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
            },
            "description": "Update authenticated user's password.\n\n- `current_password`: required, must match existing password\n- `password`: required, string, min 8, confirmed"
          },
          "response": [
            {
              "name": "Success",
              "body": "{\n  \"success\": true,\n  \"message\": \"Password updated successfully\",\n  \"data\": null\n}"
            },
            {
              "name": "Current Password Incorrect",
              "body": "{\n  \"success\": false,\n  \"message\": \"Current password is incorrect\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
    }
  ]
}
